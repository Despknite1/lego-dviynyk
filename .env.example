# Copy to .env for local dev (never commit .env). On Render set these in the dashboard / render.yaml (sync:false).
GEMINI_API_KEY=
NODE_ENV=development
PORT=8787
# --- accounts (off unless all of these are set) ---
ACCOUNTS_ENABLED=false
# 32-byte keys, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENC_KEY=
PII_INDEX_KEY=
# Postgres (Neon/Supabase). Empty => local SQLite file data/app.sqlite (dev only; in production set ALLOW_SQLITE=true to force)
DATABASE_URL=
ALLOW_SQLITE=false
# --- email for password reset: resend | smtp | console (console = dev only) ---
MAIL_PROVIDER=
MAIL_FROM=LEGO-Двійник <no-reply@yourdomain.example>
RESEND_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMS reset: stub only (no provider wired yet)
SMS_PROVIDER=
# --- misc ---
UPLOAD_MAX_BYTES=8388608
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
